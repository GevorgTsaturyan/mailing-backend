JWT_SECRET=replace_this_with_a_long_random_string
APP_URL=https://serawin.net
NODE_ENV=production

# ── Unsubscribe (RFC 8058 one-click) ─────────────────────────────────────────
# Recipient-facing base URL for unsubscribe links. MUST be under the sending
# domain so it aligns with the authenticated From domain (serawin.net).
# The subdomain is reverse-proxied to this backend — see UNSUBSCRIBE.md.
UNSUBSCRIBE_BASE_URL=https://unsubscribe.serawin.net

# Secret used to HMAC-sign unsubscribe tokens. Generate with:
#   openssl rand -hex 64
# If omitted, falls back to JWT_SECRET. Use a dedicated value in production.
UNSUBSCRIBE_SECRET=

# Unsubscribe-host readiness gate (deliverability-critical, fail-closed).
# Campaign (contact-bound) jobs are dispatched ONLY after the controller verifies
# https://<unsubscribe-host>/unsubscribe-health — mail must never ship a dead
# List-Unsubscribe endpoint. Withheld jobs stay PENDING; dispatch resumes
# automatically once the host verifies. Set to false ONLY for local dev/tests.
# UNSUBSCRIBE_REQUIRE_READY=true
# Optional probe tuning (defaults shown):
# UNSUBSCRIBE_READINESS_TTL_MS=600000      # cached readiness trusted for 10 min
# UNSUBSCRIBE_READINESS_REFRESH_MS=300000  # background re-probe every 5 min
# UNSUBSCRIBE_READINESS_TIMEOUT_MS=4000    # per-probe HTTP timeout

# Canonical queue feature flag (Milestone 5)
# Set to true to route new campaign sends through the `jobs` table (canonical pipeline).
# Set to false (or omit) to use the legacy `send_jobs` pipeline.
# Flip to true only after validating the canonical pipeline in production.
# NOTE: Button click tracking + open tracking REQUIRE the canonical queue.
USE_CANONICAL_QUEUE=false

# ── Campaign Engagement: click + open tracking ───────────────────────────────
# Recipient-facing tracking host is derived per send as:
#   <TRACKING_SUBDOMAIN>.<sending-domain>   e.g. click.serawin.net
# It is a dedicated subdomain of the SENDING domain, reverse-proxied to this
# controller (both /c/<token> redirect and /o/<token>.gif pixel). See TRACKING.md
# for the per-domain DNS/nginx/TLS wiring (mirrors the unsubscribe subdomain).
TRACKING_SUBDOMAIN=click

# Dedicated secret used to HMAC-sign click AND open tokens (full 256-bit HMAC).
# Generate with:  openssl rand -hex 64
# No fallback — tracking URLs are only built/verified when the feature is used.
TRACKING_SECRET=

# Dedicated salt for one-way hashing of client IPs in tracking events. The raw IP
# is NEVER stored — only this salted hash (for dedup / unique-clicker counting).
# Generate with:  openssl rand -hex 32
TRACKING_IP_SALT=

# Bot/scanner threshold: a click/open arriving fewer than this many seconds after
# the recipient's send is classified as scanner/prefetch (humans don't act that
# fast). Configurable; default 10.
TRACKING_FAST_THRESHOLD_SECONDS=10

# Open tracking is ON by default (see tracking_config). The readiness gate injects
# a pixel for a sending domain ONLY when its click.<domain> host is provisioned
# (DNS + TLS + nginx + endpoint), so an ON default never ships a broken pixel.
# These tune the readiness probe (optional; sensible defaults shown):
TRACKING_READINESS_TTL_MS=600000        # cached readiness is trusted for 10 min
TRACKING_READINESS_REFRESH_MS=300000    # background re-probe every 5 min
TRACKING_READINESS_TIMEOUT_MS=4000      # per-probe HTTP timeout

# Rapid-duplicate collapse + burst detection for click/open events. Legitimate
# repeat clicks spaced beyond the dedup window are still recorded (NOT single-use).
TRACKING_DEDUP_WINDOW_SECONDS=2         # collapse near-instant repeats of same button/client
TRACKING_BURST_WINDOW_SECONDS=5         # window for "scanner fetched many buttons" signal

# Raw tracking-event retention (bounds DB growth + privacy; ip_hash/UA are stored).
# Aggregate report counters are permanent; only raw click_events/open_events expire.
TRACKING_EVENT_RETENTION_DAYS=90

# Trusted reverse-proxy setting so req.ip is the real client and a client-supplied
# X-Forwarded-For cannot spoof ip_hash/classification. Default 'loopback' (controller
# behind a local nginx). Set to a hop count, boolean, or subnet list for other setups.
# TRUST_PROXY=loopback
